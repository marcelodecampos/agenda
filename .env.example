# Copie para .env e ajuste os valores antes de subir o ambiente local (docker compose up -d)

APP_NAME=Agenda
API_HOST=0.0.0.0
API_PORT=8081
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agenda:changeme@localhost:5432/agenda

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_PORT=8080
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=agenda
KEYCLOAK_MARCELO_PASSWORD=defina-localmente
KEYCLOAK_LEILA_PASSWORD=defina-localmente
