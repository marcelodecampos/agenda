# Copie para .env e ajuste os valores antes de subir o ambiente local (scripts/wslc-up.ps1)

APP_NAME=Agenda
API_HOST=0.0.0.0
API_PORT=8081
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
# Ative junto com LOG_LEVEL=DEBUG para exibir SQL e detalhes das requisições.
SQL_ECHO=false

POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agenda:changeme@localhost:5432/agenda

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_PORT=8080
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=agenda
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
# URL de um endpoint compatível com o adapter de notificações; vazio desativa o processamento HTTP.
NOTIFICACAO_WEBHOOK_URL=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=agenda@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
NOTIFICACAO_MAX_TENTATIVAS=3
KEYCLOAK_MARCELO_PASSWORD=defina-localmente
KEYCLOAK_LEILA_PASSWORD=defina-localmente

# Mínimo 8 caracteres com maiúscula, minúscula, número e caractere especial.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=defina-localmente
OPENSEARCH_PORT=9200
OPENSEARCH_URL=https://localhost:9200
